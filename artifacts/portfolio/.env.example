# EmailJS configuration for the contact form
# Get these from https://dashboard.emailjs.com/
# 1. Service ID: Email Services tab -> your service
# 2. Template ID: Email Templates tab -> your template
# 3. Public Key: Account -> API keys -> Public Key
#
# Copy this file to `.env.local` and fill in your real values.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx

