# ---------------------------------------------------------------------------
# Environment Variables Template
# Copy to `.env` (never commit it) and fill in real values.
# ---------------------------------------------------------------------------

# --- API Server ---
# Port the API server listens on (default: 8080 in dev)
PORT=8080

# Set to "production" in deployed environments (turns off pretty logging)
NODE_ENV=development

# Log level (debug | info | warn | error)
LOG_LEVEL=info

# --- Database ---
# PostgreSQL connection string used by lib/db (Drizzle).
# Leave unset to fall back to the API server's in-memory message store.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Portfolio Frontend (Vite) ---
# Base path for the built portfolio (default: "/")
# BASE_PATH=/

# API server port used by the local Vite dev proxy (default: 8080)
# API_PORT=8080

# Optional API base URL for the frontend API client.
# Leave unset to use same-origin /api (Vercel routing handles this).
# VITE_API_BASE_URL=/api

  
# --- Gmail / SMTP (contact form email delivery) ---  
# Gmail account that sends the email (must enable 2FA + create an App Password)  
# SMTP_USER=your.email@gmail.com  
# SMTP_PASS=your-16-char-app-password  
# SMTP_HOST=smtp.gmail.com  
# SMTP_PORT=465  
# SMTP_SECURE=true  
# Inbox that receives contact messages (defaults to SMTP_USER)  
# MAIL_TO=your.email@gmail.com  
